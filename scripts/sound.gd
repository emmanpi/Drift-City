extends Node

## Global audio manager (autoload `Sound`).
##
## Music is split in two tracks:
##   - in game : "The Cyber Grind" by Meganeko, the user's own MP3 placed at
##     the project root (copyrighted: never shipped/generated by this repo);
##   - in menu : `assets/audio/music/menu_theme.wav`, an original loop made by
##     `tools/generate_menu_music.py`.
## Scenes call play_game_music() / play_menu_music(); the players live in this
## autoload so the right track follows the scene with a short crossfade.
##
## SFX are original synthetic WAVs from `tools/generate_sfx.py`: two engine
## layers, a tyre skid loop and a crash one-shot. `car.gd` modulates them.

const GAME_MUSIC_CANDIDATES := [
	"res://meganeko - The Cyber Grind (Ultrakill Soundtrack).mp3",
	"res://assets/audio/music/the_cyber_grind.mp3",
	"res://assets/audio/music/the_cyber_grind.ogg",
	"res://assets/audio/music/the_cyber_grind.wav",
	"res://assets/audio/music/The Cyber Grind.mp3",
	"res://assets/audio/music/The Cyber Grind.ogg",
]
const MENU_MUSIC := "res://assets/audio/music/menu_theme.wav"

const SFX_PATHS := {
	"engine_low": "res://assets/audio/sfx/engine_low.wav",
	"engine_high": "res://assets/audio/sfx/engine_high.wav",
	"skid": "res://assets/audio/sfx/tyre_skid.wav",
	"crash": "res://assets/audio/sfx/crash.wav",
}

const MUSIC_DB := -7.0
const MUSIC_PAUSED_DB := -18.0
const MUSIC_FADE_SECONDS := 0.8
const SILENCE_DB := -80.0

var _music_players := {}
var _music_streams := {}
var _game_music_path := ""
var _current_music := ""
var _previous_music := ""
var _fade := 1.0

var _sfx := {}
var _car_active := false
var _paused := false
## Derniers niveaux demandés par la voiture (avant pause / réglages).
var _engine_low_gain := 0.0
var _engine_high_gain := 0.0
var _skid_gain := 0.0


func _ready() -> void:
	# Keep processing while paused: engine/skid loops must be silenced and the
	# music ducked when the pause menu opens.
	process_mode = Node.PROCESS_MODE_ALWAYS

	for track in ["menu", "game"]:
		_music_players[track] = _make_player("Music_" + track)
	_music_streams["menu"] = _load_loop(MENU_MUSIC)
	_game_music_path = _find_game_music()
	if _game_music_path.is_empty():
		print("[Sound] Game music not found: put the Meganeko MP3 in the project root or in assets/audio/music/")
	else:
		_music_streams["game"] = _load_loop(_game_music_path)
		if _music_streams["game"] == null:
			push_warning("[Sound] Cannot load game music: " + _game_music_path)
		else:
			print("[Sound] Game music: " + _game_music_path)
	if _music_streams["menu"] == null:
		push_warning("[Sound] Missing menu music: " + MENU_MUSIC)

	for key in SFX_PATHS.keys():
		var stream := _load_loop(String(SFX_PATHS[key]))
		if stream == null:
			push_warning("[Sound] Missing SFX: " + String(SFX_PATHS[key]))
		else:
			_sfx[key] = _make_player("SFX_" + String(key))
			_sfx[key].stream = stream
			if key != "crash":
				_sfx[key].volume_db = SILENCE_DB

	apply_settings()


func _make_player(player_name: String) -> AudioStreamPlayer:
	var player := AudioStreamPlayer.new()
	player.name = player_name
	add_child(player)
	return player


func _find_game_music() -> String:
	for path in GAME_MUSIC_CANDIDATES:
		if ResourceLoader.exists(path):
			return path
	return ""


func _load_loop(path: String) -> AudioStream:
	if not ResourceLoader.exists(path):
		return null
	var stream: AudioStream = load(path)
	if stream is AudioStreamWAV:
		var wav := stream as AudioStreamWAV
		wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
		wav.loop_end = 0
	elif stream is AudioStreamMP3:
		(stream as AudioStreamMP3).loop = true
	elif stream is AudioStreamOggVorbis:
		(stream as AudioStreamOggVorbis).loop = true
	return stream


func has_music(track: String = "game") -> bool:
	return _music_streams.get(track) != null


func music_path() -> String:
	return _game_music_path


func play_menu_music() -> void:
	_switch_music("menu")


func play_game_music() -> void:
	_switch_music("game")


func _switch_music(track: String) -> void:
	if _current_music == track:
		return
	if _music_streams.get(track) == null:
		return
	_previous_music = _current_music
	_current_music = track
	_fade = 0.0
	_update_music_volumes()


## Called by car.gd when the player enters/leaves the scene.
func start_car_sounds() -> void:
	_car_active = true
	_apply_car_volumes()
	for key in ["engine_low", "engine_high", "skid"]:
		var player: AudioStreamPlayer = _sfx.get(key)
		if player != null and player.stream != null and not player.playing:
			player.play()


func stop_car_sounds() -> void:
	_car_active = false
	_engine_low_gain = 0.0
	_engine_high_gain = 0.0
	_skid_gain = 0.0
	for key in ["engine_low", "engine_high", "skid"]:
		var player: AudioStreamPlayer = _sfx.get(key)
		if player != null:
			player.stop()


## `speed` is in m/s. Revs rise with speed (and a little with the throttle),
## then crossfade from the low engine layer to the high one.
func update_engine(speed: float, throttle: float, nitro: bool) -> void:
	var rev := clampf(speed / 32.0, 0.0, 1.0)
	if throttle > 0.0:
		rev = maxf(rev, 0.12 + 0.06 * throttle)
	if nitro:
		rev = maxf(rev, 0.88)
	var high := smoothstep(0.28, 0.80, rev)
	var load_gain := 0.09 + 0.15 * rev + 0.06 * maxf(throttle, 0.0)
	_engine_low_gain = load_gain * (1.0 - high)
	_engine_high_gain = load_gain * high
	for key in ["engine_low", "engine_high"]:
		var player: AudioStreamPlayer = _sfx.get(key)
		if player == null:
			continue
		player.pitch_scale = lerpf(0.82, 1.30, rev) + (0.04 if nitro and key == "engine_high" else 0.0)
	_apply_car_volumes()


## `intensity` in 0..1, computed from lateral slip and speed by car.gd.
func update_skid(intensity: float) -> void:
	_skid_gain = clampf(intensity, 0.0, 1.0) * 0.26
	var player: AudioStreamPlayer = _sfx.get("skid")
	if player != null:
		player.pitch_scale = lerpf(0.94, 1.08, _skid_gain / 0.26)
	_apply_car_volumes()


func play_crash(force: float = 1.0) -> void:
	var player: AudioStreamPlayer = _sfx.get("crash")
	if player == null or player.stream == null or not Game.sfx_enabled or _paused:
		return
	player.volume_db = _gain_to_db(clampf(0.14 + 0.34 * force, 0.0, 0.55))
	player.pitch_scale = 0.94 + randf() * 0.12
	player.play()


## Reads the saved music/sfx toggles (called at startup and by the pause menu).
func apply_settings() -> void:
	_update_music_volumes()
	_apply_car_volumes()


func _process(delta: float) -> void:
	var paused := get_tree().paused
	if paused != _paused:
		_paused = paused
		_update_music_volumes()
		_apply_car_volumes()
	if _fade < 1.0:
		_fade = minf(_fade + delta / MUSIC_FADE_SECONDS, 1.0)
		_update_music_volumes()


func _update_music_volumes() -> void:
	var base_db := MUSIC_PAUSED_DB if _paused else MUSIC_DB
	for track in ["menu", "game"]:
		var player: AudioStreamPlayer = _music_players.get(track)
		if player == null:
			continue
		var stream: AudioStream = _music_streams.get(track)
		if stream == null or not Game.music_enabled:
			if player.playing:
				player.stop()
			player.volume_db = SILENCE_DB
			continue
		var level := 0.0
		if track == _current_music:
			level = smoothstep(0.0, 1.0, _fade)
		elif track == _previous_music:
			level = 1.0 - smoothstep(0.0, 1.0, _fade)
		if level <= 0.001:
			if player.playing:
				player.stop()
			player.volume_db = SILENCE_DB
		else:
			if player.stream != stream:
				player.stream = stream
			if not player.playing:
				player.play()
			player.volume_db = base_db + _gain_to_db(level)
	if _fade >= 1.0 and not _previous_music.is_empty():
		_previous_music = ""


func _apply_car_volumes() -> void:
	var muted := _paused or not Game.sfx_enabled or not _car_active
	var low: AudioStreamPlayer = _sfx.get("engine_low")
	var high: AudioStreamPlayer = _sfx.get("engine_high")
	var skid: AudioStreamPlayer = _sfx.get("skid")
	if low != null:
		low.volume_db = SILENCE_DB if muted else _gain_to_db(_engine_low_gain)
	if high != null:
		high.volume_db = SILENCE_DB if muted else _gain_to_db(_engine_high_gain)
	if skid != null:
		skid.volume_db = SILENCE_DB if muted else _gain_to_db(_skid_gain)


func _gain_to_db(gain: float) -> float:
	if gain <= 0.0001:
		return SILENCE_DB
	return clampf(20.0 * log(gain) / log(10.0), SILENCE_DB, 6.0)
